# ==============================================================================
# MarketLens Environment Configuration Template
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
# ==============================================================================

# Application Gateway Port
GATEWAY_PORT=80

# PostgreSQL & TimescaleDB Configuration
POSTGRES_DB=marketlens
POSTGRES_USER=marketlens_admin
POSTGRES_PASSWORD=marketlens_dev_secret_change_me
POSTGRES_PORT=5432

# External Financial Market Data APIs (Member 4 Ingestion)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
CSE_API_KEY=your_cse_market_api_key_here

# Financial News APIs (Member 3 News Intelligence)
NEWS_API_KEY=your_news_api_key_here

# AI & Prediction Service (Member 5)
AI_SERVICE_PORT=8004
AI_MODEL_DEVICE=cpu
AI_LOG_LEVEL=info

# Market Data Service (Member 1)
MARKET_SERVICE_PORT=8001

# User & Auth Service (Java Spring Boot)
AUTH_SERVICE_PORT=8080
JWT_SECRET=super_secret_jwt_signing_key_at_least_256_bits_long_marketlens_key

# Frontend Environment Variables
VITE_API_URL=/api/v1
